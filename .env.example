# Dev-only defaults for compose.yaml. Copy to .env (gitignored): cp .env.example .env
# NEVER reuse these values outside a laptop.

# --- Postgres (one server, databases: volforecast, mlflow, prefect) ---
POSTGRES_USER=volf
POSTGRES_PASSWORD=volf-dev-only
POSTGRES_DB=volforecast

# --- MinIO (S3) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin-dev-only

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin-dev-only

# --- Host port mappings (all bound to 127.0.0.1) ---
API_PORT=8000
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MLFLOW_PORT=5000
PREFECT_PORT=4200
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# --- App ---
WEB_CONCURRENCY=2
# Image tags (override with ghcr.io/<owner>/<repo>-api:sha-xxxx to run released images)
API_IMAGE=volforecast-api:dev
JOBS_IMAGE=volforecast-jobs:dev
# Flow run by `docker compose --profile jobs run --rm jobs` (ingest|forecast|evaluate|retrain)
JOB_FLOW=forecast
